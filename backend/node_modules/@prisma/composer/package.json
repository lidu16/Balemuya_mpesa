{
  "name": "@prisma/composer",
  "version": "0.29.1",
  "type": "module",
  "description": "Prisma Composer — build a Prisma App by composing Modules. Core authoring, deploy pipeline, and the service-rpc/node/nextjs authoring surfaces. The command family the `prisma` CLI mounts lives in @prisma/composer-cli.",
  "exports": {
    ".": "./dist/index.mjs",
    "./config": "./dist/config.mjs",
    "./control": "./dist/control.mjs",
    "./deploy": "./dist/deploy.mjs",
    "./local-target": "./dist/local-target.mjs",
    "./report": "./dist/report.mjs",
    "./testing": "./dist/testing.mjs",
    "./casts": "./dist/casts.mjs",
    "./assertions": "./dist/assertions.mjs",
    "./arktype": "./dist/arktype.mjs",
    "./service-rpc": "./dist/service-rpc.mjs",
    "./node": "./dist/node.mjs",
    "./node/control": "./dist/node-control.mjs",
    "./nextjs": "./dist/nextjs.mjs",
    "./nextjs/control": "./dist/nextjs-control.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "skills"
  ],
  "dependencies": {
    "@effect/sql-d1": "4.0.0-rc.115",
    "@effect/sql-sqlite-do": "4.0.0-rc.115",
    "@effect/vitest": "4.0.0-rc.115",
    "@standard-schema/spec": "^1.1.0",
    "alchemy": "2.0.0-beta.78",
    "arktype": "^2.2.3",
    "cross-spawn": "^7.0.6",
    "effect": "4.0.0-rc.115",
    "esbuild": "^0.28.1",
    "@prisma/management-api-sdk": "^1.80.0"
  },
  "devDependencies": {
    "@internal/assemble": "0.29.1",
    "@internal/cli": "0.29.1",
    "@internal/core": "0.29.1",
    "@internal/foundation": "0.29.1",
    "@internal/lowering": "0.29.1",
    "@internal/nextjs": "0.29.1",
    "@internal/node": "0.29.1",
    "@internal/service-rpc": "0.29.1",
    "@internal/tsdown-config": "0.29.1",
    "@types/node": "^26.0.1",
    "tsdown": "^0.22.7",
    "typescript": "^6.0.3"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/prisma/composer.git",
    "directory": "packages/9-public/composer"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist skills",
    "typecheck": "tsc --noEmit"
  }
}